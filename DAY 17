        int n = sc.nextInt();
        Node head = null, tail = null;


        for (int i = 0; i < n; i++) {
            Node newNode = new Node(sc.nextInt());


            if (head == null) {
                head = tail = newNode;
                tail.next = head;
            } else {
                tail.next = newNode;
                tail = newNode;
                tail.next = head;
            }
        }


        Node prev = tail;
        Node current = head;


        do {
            Node next = current.next;
            current.next = prev;
            prev = current;
            current = next;
        } while (current != head);


        head = prev;


        Node temp = head;


        do {
            System.out.print(temp.data + " ");
            temp = temp.next;
        } while (temp != head);
    }
}

