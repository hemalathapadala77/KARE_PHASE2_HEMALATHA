import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int n = obj.nextInt();
	    int d,ans=0;
	    while(n!=0)
	    {
	        d = n%10;
	        ans = ans*10+d;
	        n = n/10;
	    }
		System.out.println("Reverse number : " +ans);
	}
}

import java.util.*;
class Main{
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int d,ec=0,oc=0;
        while(n!=0)
        {
            d=n%10;
            if(d%2==0)
            ec++;
            else 
            oc++;
            n = n/10;
        }
        System.out.println("odd digit : " +oc);
        System.out.println("even digit : " +ec);
    }
}

