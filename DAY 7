import java.util.*;
class Main{
    public static void main (String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int temp=n;
        int d,fact,sum=0;
        while(n!=0)
        {
            fact = 1;
            d=n%10;
            for(int i=0;i<=d;i++)
            fact = fact*i;
            sum = sum+fact;
            n=n/10;
        }
        if (temp==sum)
        System.out.print("Strong Number");
        else
        System.out.print("Not a Strong Number");
    }
}
