import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int n=obj.nextInt();
	    int arr[] =new int[n];
	    int i,flag=0;
	    for(i=0;i<n;i++)
	    arr[i]=obj.nextInt();
	    int t=obj.nextInt();
	    for(i=0;i<n;i++)
	    {
	        if(arr[i]==t)
	        {
	            flag=1;
	            System.out.print("present");
	            break;
	        }
	    }
	    if(flag==0)
	    System.out.print("Not present");
	}
}

